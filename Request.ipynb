    "import requests\n",
    "\n",
    "# Definimos el enlace principal indicado para el proyecto\n",
    "url = \"https://listado.mercadolibre.com.pe/laptop\"\n",
    "\n",
    "# Hacemos la petición básica\n",
    "respuesta = requests.get(url)\n",
    "\n",
    "# Comprobamos el estado de la conexión\n",
    "print(f\"Estado de la petición: {respuesta.status_code}\")"
   ]
